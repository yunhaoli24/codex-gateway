{
  "name": "@codex-gateway/ai-elements",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./tailwind.css",
    "**/*.css"
  ],
  "exports": {
    "./tailwind.css": "./tailwind.css",
    "./*": {
      "types": "./dist/types/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && vite build && vue-tsc -p tsconfig.json --declaration --emitDeclarationOnly --outDir dist/types",
    "typecheck": "vue-tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codex-gateway/ui": "workspace:*",
    "@lucide/vue": "^1.59.0",
    "@rive-app/webgl2": "^2.44.2",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/node-toolbar": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "ai": "^7.0.143",
    "ansi-to-vue3": "^0.1.2",
    "media-chrome": "^4.19.3",
    "motion-v": "^2.8.0",
    "nanoid": "^6.0.2",
    "reka-ui": "^2.11.0",
    "shiki": "4.5.0",
    "tokenlens": "^1.3.1",
    "vue-stick-to-bottom": "^1.0.1",
    "vue-stream-markdown": "^2.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "vite": "8.3.4",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13"
  },
  "peerDependencies": {
    "vue": "^3.5.40"
  }
}
