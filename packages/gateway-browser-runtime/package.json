{
  "name": "@codex-gateway/browser-runtime",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./code-highlighter": {
      "types": "./src/code-highlighter/index.ts",
      "browser": "./dist/code-highlighter/index.js",
      "default": "./dist/code-highlighter/server.js"
    },
    "./markdown": {
      "types": "./src/markdown/index.ts",
      "import": "./dist/markdown/index.js"
    },
    "./open-file-viewer": {
      "types": "./src/open-file-viewer/index.ts",
      "import": "./dist/open-file-viewer/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && node scripts/generate-code-highlighter.ts && oxfmt --write src/code-highlighter/generated.ts && vite build && rolldown -c rolldown.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdit/plugin-katex": "1.1.3",
    "@open-file-viewer/core": "0.1.49",
    "katex": "0.19.0",
    "markdown-it": "^15.0.2",
    "pdfjs-dist": "6.4.299"
  },
  "devDependencies": {
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@shikijs/types": "4.5.0",
    "@types/node": "^26.6.4",
    "oxfmt": "0.71.0",
    "rimraf": "^6.1.3",
    "rolldown": "1.2.12",
    "shiki": "4.5.0",
    "shiki-codegen": "4.5.0",
    "typescript": "^6.0.3",
    "vite": "8.3.2"
  }
}
