# Generate a production value with: openssl rand -hex 32
CODEX_GATEWAY_CONFIG_SECRET=replace-with-a-stable-random-secret

# Optional comma-separated SSH hostnames or IP addresses with a supported Codex managed outside Gateway.
# CODEX_GATEWAY_EXTERNAL_CODEX_HOSTS=build.example.com,192.0.2.10

# Per-file upload limit in MiB. Defaults to 25.
# CODEX_GATEWAY_MAX_UPLOAD_FILE_MIB=100
